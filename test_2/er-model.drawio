        <mxCell id="a6" value="vat : string" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="ARTICLE">
          <mxGeometry x="0" y="160" width="280" height="26" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="marking_flag : bool  (Честный ЗНАК)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="ARTICLE">
          <mxGeometry x="0" y="186" width="280" height="26" as="geometry" />
