        <mxCell id="b4" value="article_id_fk (FK, nullable) : string" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;fontStyle=2;" vertex="1" parent="SUPPLIER_POSITION">
