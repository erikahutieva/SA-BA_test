        <mxCell id="SUPPLIER_POSITION" value="SUPPLIER_POSITION (Позиция поставщика)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fontStyle=1;fontSize=13;fillColor=#F3EFE7;strokeColor=#C9A46A;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="320" height="212" as="geometry" />
