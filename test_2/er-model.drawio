        </mxCell>
        <mxCell id="a3" value="vendor : string" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="ARTICLE">
          <mxGeometry x="0" y="82" width="280" height="26" as="geometry" />
