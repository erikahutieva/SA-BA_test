        <mxCell id="rel1" value="связан с (0..n)" style="html=1;rounded=0;edgeStyle=entityRelationEdgeStyle;fontSize=11;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ARTICLE" target="SUPPLIER_POSITION">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="PK — первичный ключ · FK — внешний ключ (курсив) · article_id_fk = null означает, что позиция отвязана от артикула" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#5B645F;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="700" height="30" as="geometry" />
